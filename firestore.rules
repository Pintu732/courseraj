rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "vovanew76@gmail.com";
    }

    match /courses/{id} {
      allow read: if resource.data.published != false || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if resource.data.visible != false || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /siteSettings/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /media/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
